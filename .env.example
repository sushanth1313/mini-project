# Smart Land Valuation & Geospatial Analysis System — Production Configuration Example
# Copy to .env and configure values before staging/production deployment. Never commit real secrets.

FLASK_ENV=production
SECRET_KEY=replace-with-strong-random-32byte-hex
ADMIN_SECRET_KEY=replace-with-strong-admin-jwt-secret
DEFAULT_SUPER_ADMIN_PASSWORD=replace-before-first-boot
JWT_TOKEN_EXPIRY_MINUTES=120

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document Analyzer Auth & Local OCR
API_AUTH_REQUIRED=true
AI_PROVIDER=local_heuristic
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional Google Maps / Geocoding / Places (never hardcode keys in source code)
# GOOGLE_MAPS_API_KEY=

# Frontend Vite build variables (place in frontend/.env)
# VITE_API_URL=http://localhost:5000/api
# VITE_GOOGLE_MAPS_API_KEY=
